{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/env.d.ts",
    "src/main.ts",
    "src/App.vue",
    "src/router/index.ts",
    "src/styles/**/*.css",
    "src/views/BeadStudio.vue",
    "src/views/MardCards.vue",
    "src/components/Bead*.vue",
    "src/composables/usePerler.ts",
    "src/data/mardPalettes.ts",
    "src/data/shopData.ts"
  ]
}
